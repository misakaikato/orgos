{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"plugins": [{ "name": "next" }],
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": ".next/tsconfig.tsbuildinfo",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
