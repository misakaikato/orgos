{
	"name": "@orgos/server",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "NO_PROXY=localhost,127.0.0.1 bun run --watch src/serve.ts",
		"start": "NO_PROXY=localhost,127.0.0.1 bun run src/serve.ts",
		"auth:generate": "bunx @better-auth/cli@1.4.22 generate --config src/auth.ts --output src/db/auth-schema.ts --yes && biome format --write src/db/auth-schema.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@orgos/protocol": "workspace:*",
		"better-auth": "1.4.22",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.32",
		"postgres": "3.4.9",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"drizzle-kit": "0.31.10",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	}
}
