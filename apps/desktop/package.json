{
	"name": "@orgos/desktop",
	"private": true,
	"version": "0.1.0",
	"description": "orgos 桌面客户端：聊天窗口与菜单栏 Runner 看护",
	"author": "orgos",
	"type": "module",
	"main": "dist/app/main.cjs",
	"scripts": {
		"dev": "NO_PROXY=localhost,127.0.0.1 bun scripts/build.ts && NO_PROXY=localhost,127.0.0.1 electron .",
		"build": "NO_PROXY=localhost,127.0.0.1 bun scripts/build.ts && NO_PROXY=localhost,127.0.0.1 electron-builder --mac --arm64 --publish never",
		"test": "NO_PROXY=localhost,127.0.0.1 bun test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@orgos/protocol": "workspace:*",
		"@orgos/runner": "workspace:*",
		"@types/bun": "1.3.14",
		"electron": "44.4.5",
		"electron-builder": "26.15.3",
		"typescript": "5.9.3"
	},
	"build": {
		"appId": "local.orgos.desktop",
		"productName": "orgos",
		"electronVersion": "44.4.5",
		"directories": {
			"output": "dist/release"
		},
		"files": [
			"dist/app/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "dist/runner",
				"to": "runner"
			}
		],
		"mac": {
			"target": [
				"dmg"
			],
			"category": "public.app-category.productivity",
			"identity": null
		},
		"win": {
			"target": [
				"nsis"
			]
		},
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Office"
		}
	}
}
